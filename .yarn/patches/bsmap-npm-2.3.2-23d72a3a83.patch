+/** Check if event type is a basic event with no special controls. */
+export function isBasicNoneTrack(type, tracks) {
+    return tracks[type].type === -1;
+}
+/** Check if event type is a basic event with "light" controls. */
+export function isBasicLightTrack(type, tracks) {
+    return tracks[type].type === 0;
+}
+/** Check if event type is a basic event with "toggle" controls. */
+export function isBasicToggleTrack(type, tracks) {
+    return tracks[type].type === 1;
+}
+/** Check if event type is a basic event with "float value" controls. */
+export function isBasicFloatValueTrack(type, tracks) {
+    return tracks[type].type === 3;
+}
+/** Check if event type is a basic event with "integer value" controls. */
+export function isBasicIntValueTrack(type, tracks) {
+    return tracks[type].type === 4;
+}
+/** Check if event type is a basic event with "character selection" controls. */
+export function isBasicBtsTrack(type, tracks) {
+    return tracks[type].type === 5;
+}
+/** Check if event type is a basic event with "car selection" controls. */
+export function isBasicCarTrack(type, tracks) {
+    return tracks[type].type === 6;
+}
+export function getBasicTracksForEnvironment(environment, renamer) {
+    if (!(environment in BasicTrackDefinitions)) {
+        return {};
+    }
+    const basicTracks = BasicTrackDefinitions[environment];
+    for (const type of Object.keys(basicTracks).map((key) => Number.parseInt(key, 10))) {
+        basicTracks[type] = { ...basicTracks[type], id: type };
+        if (renamer)
+            basicTracks[type].name = renamer?.(type, environment);
+    }
+    return basicTracks;
+}
+export function getGroupTracksForEnvironment(environment, renamer) {
+    if (!(environment in GroupTrackDefinitions)) {
+        return {};
+    }
+    const groupTracks = GroupTrackDefinitions[environment];
+    for (const id of Object.keys(groupTracks).map((key) => Number.parseInt(key, 10))) {
+        groupTracks[id] = { ...groupTracks[id], id };
+        if (renamer)
+            groupTracks[id].name = renamer?.(id, environment);
+    }
+    return groupTracks;
+}
